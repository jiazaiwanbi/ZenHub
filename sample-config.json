{
  "listen": "127.0.0.1:8080",
  "observability": {
    "max_records": 200
  },
  "sync": {
    "enabled": false,
    "server_url": "http://127.0.0.1:8081",
    "username": "admin",
    "password_env": "ZENHUB_COMMUNITY_PASSWORD"
  },
  "codex": {
    "config_dir": "/path/to/.codex",
    "current_provider_group": "openai-direct"
  },
  "providers": [
    {
      "name": "openai-direct",
      "protocol": "openai",
      "mode": "direct",
      "base_url": "https://api.openai.com",
      "api_key_env": "OPENAI_API_KEY",
      "timeout": "30s",
      "retry_count": 1,
      "passive_health": {
        "failure_threshold": 2,
        "cooldown": "30s"
      },
      "models": [
        {
          "alias": "gpt-4o-mini",
          "real_model": "gpt-4o-mini",
          "weight": 2
        },
        {
          "alias": "sonnet",
          "real_model": "gpt-4o-mini"
        }
      ],
      "codex": {
        "auth": {
          "OPENAI_API_KEY": "env:OPENAI_API_KEY"
        },
        "config": "model_provider = \"openai-direct\"\n\n[model_providers.openai-direct]\nbase_url = \"https://api.openai.com\"\nwire_api = \"responses\"\n"
      }
    },
    {
      "name": "community-relay",
      "protocol": "openai",
      "mode": "relay",
      "base_url": "http://127.0.0.1:8081",
      "api_key_env": "ZENHUB_COMMUNITY_TOKEN",
      "timeout": "10s",
      "retry_count": 0,
      "passive_health": {
        "failure_threshold": 1,
        "cooldown": "10s"
      },
      "models": [
        {
          "alias": "relay-model",
          "real_model": "relay-model"
        }
      ],
      "codex": {
        "auth": {
          "ZENHUB_COMMUNITY_TOKEN": "env:ZENHUB_COMMUNITY_TOKEN"
        },
        "config": "model_provider = \"community-relay\"\n\n[model_providers.community-relay]\nbase_url = \"http://127.0.0.1:8081\"\nwire_api = \"chat_completions\"\n"
      }
    },
    {
      "name": "anthropic-direct",
      "protocol": "anthropic",
      "mode": "direct",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout": "30s",
      "retry_count": 1,
      "passive_health": {
        "failure_threshold": 2,
        "cooldown": "30s"
      },
      "models": [
        {
          "alias": "sonnet",
          "real_model": "claude-3-7-sonnet"
        }
      ]
    }
  ]
}
